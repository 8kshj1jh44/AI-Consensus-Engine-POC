# AI Consensus Engine - Environment Config

# Provider API keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_WORKSPACE_ID=your_anthropic_workspace_id_here

# Worker model IDs
GEMINI_MODEL=gemini-3.8-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Arbiter configuration
ARBITER_MODEL_PROVIDER=anthropic
ANTHROPIC_ARBITER_MODEL=claude-sonnet-5-5
OPENAI_ARBITER_MODEL=gpt-4o

# Timeouts (seconds): workers vs. arbiter synthesis
REQUEST_TIMEOUT_SECONDS=12
ARBITER_TIMEOUT_SECONDS=60
